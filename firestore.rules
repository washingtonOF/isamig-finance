rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function verified() { return request.auth != null && request.auth.token.email_verified == true; }
  function master() { return verified() && request.auth.token.email == 'washington.s.souza@gmail.com' && request.auth.token.firebase.sign_in_provider == 'google.com'; }
  function unitValid(u) { return u in ['101','102','103','104','201','202','203','204','301','302','303','304','401','402','403','404','501','502','503','504','601','602']; }
  function validAssignment(d) { return unitValid(d.unit) && d.unit != '204' && ((d.role == 'administrative' && d.unit in ['101','201']) || d.role == 'resident'); }
  // Registration requests are private and resolved by a trusted service.
  match /registration_delete_requests/{uid} {
   allow get, list: if master();
   allow create: if master() && uid != request.auth.uid
     && request.resource.data.keys().hasOnly(['email','status','requestedBy','requestedAt'])
     && request.resource.data.email is string && request.resource.data.email != 'washington.s.souza@gmail.com'
     && request.resource.data.status == 'queued'
     && request.resource.data.requestedBy == request.auth.uid && request.resource.data.requestedAt == request.time
     && !exists(/databases/$(database)/documents/registration_decisions/$(uid))
     && !exists(/databases/$(database)/documents/test_access/$(uid))
     && (!exists(/databases/$(database)/documents/users/$(uid)) || get(/databases/$(database)/documents/users/$(uid)).data.status == 'pending');
   allow update, delete: if false;
  }
  match /registration_auth_inventory/{uid} {
   allow get, list: if master();
   allow write: if false;
  }
  match /registration_claims/{uid} {
   allow get: if master() || (verified() && request.auth.uid == uid);
   allow list: if master();
   allow create: if verified() && request.auth.uid == uid
     && request.resource.data.keys().hasOnly(['cpf','phone','whatsapp','email','createdAt'])
     && request.resource.data.keys().hasAll(['cpf','phone','whatsapp','email','createdAt'])
     && request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{10,13}$')
     && request.resource.data.whatsapp is bool
     && request.resource.data.email == request.auth.token.email
     && request.resource.data.cpf is string
     && request.resource.data.cpf.matches('^[0-9]{11}$')
     && request.resource.data.createdAt == request.time;
   allow update, delete: if false;
  }
  match /registration_decisions/{uid} {
   allow get, list: if master();
   allow create: if false;
   allow update, delete: if false;
  }
  match /registration_review_private/{uid} {
   allow get, list: if master();
   allow write: if false;
  }
  match /users/{uid} {
   allow read: if master() || (verified() && request.auth.uid == uid);
   allow create: if verified() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['email','name','role','status']) && request.resource.data.email == request.auth.token.email && request.resource.data.name is string && request.resource.data.role == 'user' && request.resource.data.status == 'pending';
   allow update: if master() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status'])
     && resource.data.status == 'approved'
     && request.resource.data.unit == resource.data.unit
     && ((request.resource.data.status == 'approved' && validAssignment(request.resource.data)) || (request.resource.data.status == 'revoked' && request.resource.data.role == resource.data.role));
   allow delete: if false;
  }
  function approved() { return verified() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == request.auth.token.email && validAssignment(get(/databases/$(database)/documents/users/$(request.auth.uid)).data); }
  function administrative() { return approved() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrative'; }
  function own(u) { return approved() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unit == u; }
  function validResident(d) { return d.keys().hasAll(['owner','responsible','cpf','phone','email','occupation','count','start','updatedBy','updatedAt']) && d.keys().hasOnly(['owner','responsible','cpf','phone','email','contactEmail','occupation','count','start','updatedBy','updatedAt']) && (!('contactEmail' in d) || (d.contactEmail is string && d.contactEmail.size() <= 254)) && d.owner is string && d.owner.size() <= 150 && d.responsible is string && d.responsible.size() <= 150 && d.cpf is string && d.cpf.size() <= 14 && d.phone is string && d.phone.size() <= 30 && d.email is string && d.email.size() <= 254 && d.occupation in ['Não informado','Proprietário residente','Inquilino','Cedido','Desocupado'] && d.count is int && d.count >= 0 && d.count <= 100 && d.start is string && d.start.size() <= 10 && d.updatedBy == request.auth.uid && d.updatedAt == request.time; }
  match /resident_contact_preferences/{u} {
   allow get: if unitValid(u) && (master() || administrative() || own(u));
   allow list, write: if false;
  }
  // Retired test environment: retain records for audit, deny all browser access.
  // Retired virtual unit: historical records remain inaccessible to residents.
  match /test_access/{uid} {
   allow read: if master();
   allow write: if false;
  }
  match /test_units/{document=**} {
   allow read: if master();
   allow write: if false;
  }
  match /residents/{u} {
   allow get: if unitValid(u) && (master() || administrative() || own(u));
   allow list: if master() || administrative();
   allow create: if unitValid(u) && master() && validResident(request.resource.data);
   allow update: if unitValid(u) && validResident(request.resource.data) && (master() || (administrative() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone','occupation','count','start','updatedBy','updatedAt'])) || (own(u) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone','contactEmail','occupation','updatedBy','updatedAt'])));
   allow delete: if false;
  }
  match /unit_access_preferences/{u} {
   allow get, list: if master();
   allow create, update: if master() && unitValid(u) && u != '204'
     && request.resource.data.keys().hasAll(['role','updatedBy','updatedAt'])
     && request.resource.data.keys().hasOnly(['role','updatedBy','updatedAt'])
     && (request.resource.data.role == 'resident' || (request.resource.data.role == 'administrative' && u in ['101','201']))
     && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  // Imported payer records are private and immutable from browser clients.
  match /cora_import_private/{payer} {
   allow get, list: if master() || administrative();
   allow write: if false;
  }
  match /unit_payer_links/{u} {
   allow get: if unitValid(u) && (master() || administrative());
   allow list: if master() || administrative();
   allow create, update: if unitValid(u) && (master() || administrative())
     && request.resource.data.keys().hasOnly(['payer','updatedBy','updatedAt'])
     && request.resource.data.keys().hasAll(['payer','updatedBy','updatedAt'])
     && request.resource.data.payer is string
     && (request.resource.data.payer == '' || (request.resource.data.payer.matches('^[a-f0-9]{64}$') && exists(/databases/$(database)/documents/cora_import_private/$(request.resource.data.payer))))
     && request.resource.data.updatedBy == request.auth.uid
     && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  // Financial projections are written only by the trusted server identity (IAM).
  match /cora_invoice_private/{invoice} {
   allow get, list: if master() || administrative();
   allow write: if false;
  }
  match /finance_admin/{period} {
   allow get: if master() || administrative();
   allow list, write: if false;
  }
  match /finance_public/{period} {
   allow get: if master() || approved();
   allow list, write: if false;
  }
  match /finance_units/{u}/months/{period} {
   allow get: if unitValid(u) && (master() || administrative() || (own(u) && resource.data.paymentSchema == 1 && resource.data.authorizedUid == request.auth.uid));
   allow list, write: if false;
  }
  match /unit_notices/{u}/messages/{id}/views/{uid} {
   allow get, list: if unitValid(u) && (master() || administrative() || own(u));
   allow create: if unitValid(u) && (own(u) || (master() && u == '204')) && uid == request.auth.uid
     && exists(/databases/$(database)/documents/unit_notices/$(u)/messages/$(id))
     && request.resource.data.keys().hasOnly(['viewedAt','uid','name'])
     && request.resource.data.keys().hasAll(['viewedAt','uid','name'])
     && request.resource.data.uid == uid && request.resource.data.viewedAt == request.time
     && ((master() && u == '204' && request.resource.data.name == request.auth.token.name) || (own(u) && request.resource.data.name == get(/databases/$(database)/documents/users/$(uid)).data.name));
   allow update, delete: if false;
  }
  match /unit_notices/{u}/messages/{id}/receipts/{uid} {
   allow get, list: if unitValid(u) && (master() || administrative() || own(u));
   allow create: if unitValid(u) && (own(u) || (master() && u == '204')) && uid == request.auth.uid
     && exists(/databases/$(database)/documents/unit_notices/$(u)/messages/$(id))
     && request.resource.data.keys().hasOnly(['confirmedAt','uid','name'])
     && request.resource.data.keys().hasAll(['confirmedAt','uid','name'])
     && request.resource.data.uid == uid && request.resource.data.confirmedAt == request.time
     && ((master() && u == '204' && request.resource.data.name == request.auth.token.name) || (own(u) && request.resource.data.name == get(/databases/$(database)/documents/users/$(uid)).data.name));
   allow update, delete: if false;
  }
  match /unit_notices/{u}/messages/{id} {
   allow get, list: if unitValid(u) && (master() || administrative() || own(u));
   allow create: if unitValid(u) && (master() || administrative())
     && request.resource.data.keys().hasAll(['type','subject','body','date','createdBy','createdAt'])
     && request.resource.data.keys().hasOnly(['type','subject','body','date','createdBy','createdAt','richBody','signerName','signerRole'])
     && ( !('signerName' in request.resource.data) && !('signerRole' in request.resource.data) || (request.resource.data.signerName is string && request.resource.data.signerName.size() > 0 && request.resource.data.signerName.size() <= 200 && ((master() && request.resource.data.signerRole == 'Master' && request.resource.data.signerName == request.auth.token.name) || (administrative() && request.resource.data.signerRole == 'Administrativo' && request.resource.data.signerName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name))))
     && (!('richBody' in request.resource.data) || (request.resource.data.richBody is string && request.resource.data.richBody.size() <= 60000))
     && request.resource.data.type in ['Comunicado','Notificação','Advertência','Convocação de assembleia','Declaração','Aviso de manutenção','Notificação de cobrança','Outros']
     && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 200
     && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 12000
     && request.resource.data.date is string && request.resource.data.date.size() == 10
     && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
   allow update, delete: if false;
  }
  match /official_documents/regimento {
   allow get: if master() || approved();
   allow list: if false;
   allow create, update: if master()
     && request.resource.data.keys().hasOnly(['name','pdf','updatedAt','updatedBy'])
     && request.resource.data.keys().hasAll(['name','pdf','updatedAt','updatedBy'])
     && request.resource.data.name is string && request.resource.data.name.size() <= 200
     && request.resource.data.pdf is string && request.resource.data.pdf.size() <= 900000
     && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
   allow delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
